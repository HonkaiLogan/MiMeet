# ========== 服务配置 ==========
PORT=5000
SESSION_SECRET=your-session-secret
APP_URL=http://localhost:5000

# 开发环境登录旁路(仅 NODE_ENV != production):?dev=u001 注入种子用户 session
ALLOW_DEV_AUTH=1

# ========== MySQL 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=mimeet

# ========== 飞书开放平台 ==========
# 在开发者后台 (open.feishu.cn) 创建"网页应用",在安全设置里:
#   1. 重定向 URL 白名单加入: FEISHU_REDIRECT_URI 的值
#   2. H5 可信域名 加入: APP_URL 的域名(端口)
#   3. 权限管理: 添加 contact:user.base:readonly (拉基础资料), contact:user.employee:readonly (拉部门,可选)
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_REDIRECT_URI=http://localhost:5000/auth/callback
FEISHU_LOGIN_LANDING=/#/home

# ========== Xiaomi MiMo API ==========
MIMO_API_URL=https://api.mimo.example.com/v1/chat
MIMO_API_KEY=your-mimo-api-key
